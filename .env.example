# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  cp .env.example .env

# ===== LINE Messaging API (บอทส่งแจ้งเตือน) =====
# Channel access token (long-lived) จาก Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=

# ===== LINE Login (สำหรับให้ผู้ใช้ล็อกอิน) =====
# สร้าง LINE Login channel ใน provider เดียวกับ Messaging API
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# URL หลักของเว็บ (ใช้ประกอบ redirect URI = BASE_URL/callback)
# ตอนรันในเครื่อง: http://localhost:5000   ตอน deploy: https://<your-app>.onrender.com
BASE_URL=http://localhost:5000

# กุญแจเข้ารหัส session (สุ่มอะไรก็ได้ ยาว ๆ)
SECRET_KEY=change-me-to-a-random-string

# ===== ตั้งค่าทั่วไป =====
DEFAULT_REMIND_DAYS_BEFORE=3
TIMEZONE=Asia/Bangkok
WEB_PORT=5000

# เปิด background scheduler ในตัวเว็บ (1=เปิด) — ตอน deploy ควรตั้งเป็น 1
RUN_SCHEDULER=0
NOTIFY_MINUTE=0
