# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# คำสั่ง:  cp .env.example .env

# Token จาก LINE Messaging API channel (Channel access token แบบ long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# User ID ของผู้รับการแจ้งเตือน (ขึ้นต้นด้วยตัว U)
LINE_TO_USER_ID=

# จำนวนวันก่อนถึงกำหนดที่จะเริ่มเตือน
DEFAULT_REMIND_DAYS_BEFORE=3

# โซนเวลา
TIMEZONE=Asia/Bangkok

# พอร์ตเว็บ
WEB_PORT=5000
